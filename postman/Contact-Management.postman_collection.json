{
  "info": {
    "name": "Contact Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Creates and deletes only its own uniquely named test contact."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Create contact",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contactId\": \"{{testId}}\",\n  \"name\": \"Postman Contact\",\n  \"phone\": \"9876543210\",\n  \"email\": \"{{testEmail}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = 'postman-' + pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('testId', id);",
              "pm.collectionVariables.set('testEmail', id + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Saved ID', () => pm.expect(pm.response.json().contactId).to.eql(pm.collectionVariables.get('testId')));"
            ]
          }
        }
      ]
    },
    {
      "name": "List contacts",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/contacts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Contact appears in list', () => pm.expect(pm.response.json().some(c => c.contactId === pm.collectionVariables.get('testId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get contact",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/contacts/{{testId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Name persisted', () => pm.expect(pm.response.json().name).to.eql('Postman Contact'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contactId\": \"{{testId}}\",\n  \"name\": \"Postman Contact\",\n  \"phone\": \"9876543210\",\n  \"email\": \"other-{{testEmail}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contactId\": \"{{testId}}-other\",\n  \"name\": \"Postman Contact\",\n  \"phone\": \"9876543210\",\n  \"email\": \"{{testEmail}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid phone",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid\",\n  \"phone\": \"123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Invalid\",\n  \"phone\": \"1234567890\",\n  \"email\": \"invalid\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing name",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"1234567890\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update contact",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts/{{testId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Contact\",\n  \"phone\": \"0123456789\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Phone updated', () => pm.expect(pm.response.json().phone).to.eql('0123456789'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject invalid update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/contacts/{{testId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"bad\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify persisted update",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/contacts/{{testId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Update persisted', () => pm.expect(pm.response.json().name).to.eql('Updated Contact'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete contact",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/contacts/{{testId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Deleted contact is missing",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/contacts/{{testId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
